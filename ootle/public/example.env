# Settings for ootle/public/up.sh. Copy it somewhere outside the repo, keep it private (chmod 600), edit, and run
#   ootle/public/up.sh ~/ootlerouter.env
# Everything is optional except where noted.

# Your model: an OpenAI-compatible server (llama.cpp, vLLM, Ollama...) listening on 127.0.0.1 of this machine.
# OR_MODEL is its model id. Without these, add a model in the console under Bring your own key.
OR_MODEL_PORT=8899
OR_MODEL=offrail-27b

# Which agent harnesses to install (a comma-separated list; opencode is small and works with local models).
OR_BACKENDS=opencode

# The router's account in its own wallet; up.sh prints its address so you can fund it for claim fees.
OR_ACCOUNT=router

# The Ootle network: a file in ootle/deployments/ (esmeralda.json is the testnet).
OR_DEPLOYMENT=esmeralda.json

# Limits on the router's container (the agents run in it).
OR_CPUS=4
OR_MEMORY=8g

# Pages that may call your API from a browser with a payer's key.
OR_CORS_ORIGINS=https://ootlebook.com

# Where your console key and password are kept (default ~/.config/ootlerouter).
# OR_KEYS_DIR=
# Your own console password file (default: one is made for you in OR_KEYS_DIR).
# OR_PASSWORD_FILE=

# Payments: µT a running turn holds, the smallest claim worth making, what a claim costs in fees (a closing lane
# isn't claimed for less), how often to claim (seconds).
# OOTLE_RESERVE=10000
# OOTLE_CLAIM_MIN=100000
# OOTLE_CLAIM_FEE=5000
# OOTLE_CLAIM_EVERY_S=600

# Images: the published ones by default. OR_BUILD=1 builds both from this checkout instead.
# OR_BUILD=1
# OR_IMAGE=ghcr.io/alex3000-ai/ootlerouter:latest
# OR_EDGE_IMAGE=ghcr.io/alex3000-ai/ootlerouter-edge:latest
# OR_RUNTIME=runsc-netraw     # default: runsc-netraw when Docker has it, else runc
